{
  "name": "@uni-proxy-manager/analytics",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && bun scripts/copy-non-ts-files.js",
    "start": "node dist/index.js",
    "start:bun": "bun run dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@hono/zod-validator": "^0.9.1",
    "@uni-proxy-manager/database": "workspace:*",
    "@uni-proxy-manager/queue": "workspace:*",
    "@uni-proxy-manager/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "ioredis": "5.11.1",
    "jose": "^5.10.0",
    "nanoid": "^5.1.16",
    "ua-parser-js": "^2.0.10",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
